<mxfile host="drawio"><diagram id="C4 Containers — обновлённая" name="C4 Containers — обновлённая"><mxGraphModel grid="1" gridSize="10" page="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="c32" value="&lt;b&gt;Домен «Дата»&lt;/b&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2440" y="1100" width="560" height="360" as="geometry"/></mxCell><mxCell id="c28" value="&lt;b&gt;Домен «Финансы»&lt;/b&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="2440" y="600" width="560" height="460" as="geometry"/></mxCell><mxCell id="c18" value="&lt;b&gt;Домен «ЖКУ»&lt;/b&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="1160" y="600" width="1220" height="860" as="geometry"/></mxCell><mxCell id="c8" value="&lt;b&gt;Домен «Продажи»&lt;/b&gt;" style="rounded=1;fontSize=12;whiteSpace=wrap;html=1;dashed=1;arcSize=2;fillColor=none;strokeColor=#666666;fontColor=#333333;labelBackgroundColor=none;align=left;verticalAlign=bottom;labelBorderColor=none;spacingTop=0;spacing=10;dashPattern=8 4;metaEdit=1;rotatable=0;perimeter=rectanglePerimeter;labelPadding=0;allowArrows=0;connectable=0;expand=0;recursiveResize=0;editable=1;pointerEvents=0;absoluteArcSize=1;points=[[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0.25,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0],[0,0.25,0]];" vertex="1" parent="1"><mxGeometry x="0" y="600" width="1100" height="620" as="geometry"/></mxCell><mxCell id="c2" value="&lt;b&gt;Клиент&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Потенциальный покупатель жилья&lt;/div&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="380" y="0" width="200" height="180" as="geometry"/></mxCell><mxCell id="c3" value="&lt;b&gt;Собственник&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Пользуется мобильным приложением&lt;/div&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="1500" y="0" width="200" height="180" as="geometry"/></mxCell><mxCell id="c4" value="&lt;b&gt;Сотрудник&lt;/b&gt;&lt;div&gt;[Person]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Менеджер операционной команды&lt;/div&gt;" style="shape=mxgraph.c4.person2;whiteSpace=wrap;html=1;align=center;metaEdit=1;points=[[0.5,0,0],[1,0.5,0],[1,0.75,0],[0.75,1,0],[0.5,1,0],[0.25,1,0],[0,0.75,0],[0,0.5,0]];resizable=0;fillColor=#083F75;fontColor=#ffffff;strokeColor=#06315C;" vertex="1" parent="1"><mxGeometry x="2650" y="0" width="200" height="180" as="geometry"/></mxCell><mxCell id="c5" value="&lt;b&gt;Межсетевой экран + WAF&lt;/b&gt;&lt;div&gt;[Firewall / WAF]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Единственная точка входа внешних пользователей. Новое: WAF-правила&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="900" y="250" width="320" height="90" as="geometry"/></mxCell><mxCell id="c6" value="&lt;b&gt;API Gateway&lt;/b&gt;&lt;div&gt;[Container: Kong / NGINX]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;НОВОЕ. Единая точка API для клиентов и партнёров: проверка JWT, scope и tenant, rate limit, журналирование&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2D9C3C;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E6B29;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="900" y="400" width="320" height="110" as="geometry"/></mxCell><mxCell id="c7" value="&lt;b&gt;Identity Provider (IAM)&lt;/b&gt;&lt;div&gt;[Container: Keycloak, OIDC/OAuth 2.0]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;НОВОЕ. Единая регистрация и аутентификация клиентов, собственников, партнёров и сотрудников (федерация со службой каталогов), MFA&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2D9C3C;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E6B29;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1300" y="400" width="320" height="130" as="geometry"/></mxCell><mxCell id="c9" value="&lt;b&gt;Витрина продаж&lt;/b&gt;&lt;div&gt;[Container: монолит]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Подбор и бронирование недвижимости&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c10" value="&lt;b&gt;client-tour-app&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Онлайн-тур&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="300" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c11" value="&lt;b&gt;client-mart-app&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Онлайн-сделка&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c12" value="&lt;b&gt;client-crm-app&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Управление клиентскими данными (мастер-данные клиента)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="240" height="100" as="geometry"/></mxCell><mxCell id="c13" value="&lt;b&gt;client-mart-estate-app&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Данные о недвижимости&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="220" height="100" as="geometry"/></mxCell><mxCell id="c14" value="&lt;b&gt;БД tour&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="300" y="920" width="220" height="80" as="geometry"/></mxCell><mxCell id="c15" value="&lt;b&gt;БД mart&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="560" y="920" width="220" height="80" as="geometry"/></mxCell><mxCell id="c16" value="&lt;b&gt;БД CRM клиентов&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="820" y="920" width="240" height="80" as="geometry"/></mxCell><mxCell id="c17" value="&lt;b&gt;БД estate&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="220" height="80" as="geometry"/></mxCell><mxCell id="c19" value="&lt;b&gt;Витрина ЖКУ / мобильное приложение собственника&lt;/b&gt;&lt;div&gt;[Container: Mobile App]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;ЖКУ, информация УК, ремонты. Новое: раздел «Умный дом» — домофон, шлагбаум, гости, авто&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1200" y="640" width="320" height="130" as="geometry"/></mxCell><mxCell id="c20" value="&lt;b&gt;tenant-core-app&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Сервис предоставления услуг собственникам&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1560" y="640" width="240" height="100" as="geometry"/></mxCell><mxCell id="c21" value="&lt;b&gt;CRM ЖКУ&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Данные о собственниках&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1840" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c22" value="&lt;b&gt;БД tenant-core&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1560" y="920" width="240" height="80" as="geometry"/></mxCell><mxCell id="c23" value="&lt;b&gt;БД CRM ЖКУ&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="1840" y="920" width="220" height="80" as="geometry"/></mxCell><mxCell id="c24" value="&lt;b&gt;smart-home-service&lt;/b&gt;&lt;div&gt;[Container: Java/Go]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;НОВОЕ. Управление правами доступа (кто, куда, когда), гостевые пропуска, номера авто, согласия на биометрию; команды и события партнёра&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2D9C3C;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E6B29;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1050" width="320" height="140" as="geometry"/></mxCell><mxCell id="c25" value="&lt;b&gt;БД smart-home&lt;/b&gt;&lt;div&gt;[PostgreSQL, шифрование]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;НОВОЕ. Права доступа, номера авто, журнал событий. Без биометрических шаблонов&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#2D9C3C;fontColor=#ffffff;strokeColor=#1E6B29;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1200" y="1290" width="320" height="110" as="geometry"/></mxCell><mxCell id="c26" value="&lt;b&gt;Partner Integration Gateway&lt;/b&gt;&lt;div&gt;[Container: egress-шлюз]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;НОВОЕ. Единая точка исходящих и входящих вызовов к партнёрам: mTLS, OAuth 2.0 client credentials, проверка HMAC вебхуков, фильтрация полей&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2D9C3C;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E6B29;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="1600" y="1110" width="320" height="140" as="geometry"/></mxCell><mxCell id="c27" value="&lt;b&gt;Брокер событий&lt;/b&gt;&lt;div&gt;[Container: Kafka]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;НОВОЕ. Асинхронные события «Умного дома» (проход, звонок, тревога)&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#2D9C3C;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#1E6B29;strokeWidth=3;dashed=1;" vertex="1" parent="1"><mxGeometry x="2000" y="1110" width="280" height="110" as="geometry"/></mxCell><mxCell id="c29" value="&lt;b&gt;accountant-service-1&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Финансовый учёт&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="2480" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c30" value="&lt;b&gt;БД учёта&lt;/b&gt;&lt;div&gt;[PostgreSQL]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;&lt;/div&gt;" style="shape=cylinder3;size=12;whiteSpace=wrap;html=1;boundedLbl=1;fillColor=#23A2D9;fontColor=#ffffff;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="2480" y="900" width="220" height="80" as="geometry"/></mxCell><mxCell id="c31" value="&lt;b&gt;Служба каталогов&lt;/b&gt;&lt;div&gt;[Container: AD/LDAP]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Учётные записи сотрудников&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="2740" y="640" width="220" height="100" as="geometry"/></mxCell><mxCell id="c33" value="&lt;b&gt;Хранилище данных&lt;/b&gt;&lt;div&gt;[Container: DWH]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Новое: доступ по ролям, маскирование ПДн&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" parent="1"><mxGeometry x="2480" y="1140" width="220" height="100" as="geometry"/></mxCell><mxCell id="c34" value="&lt;b&gt;BI и отчётность&lt;/b&gt;&lt;div&gt;[Container]&lt;/div&gt;&lt;br&gt;&lt;div style='font-size:11px'&gt;Аналитика и отчёты&lt;/div&gt;" style="rounded=1;whiteSpace=wrap;html=1;labelBackgroundColor=none;fillColor=#23A2D9;fontColor=#ffffff;align=center;arcSize=10;strokeColor=#0E7DAD;" vertex="1" 